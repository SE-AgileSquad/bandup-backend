# Copy this file to infra/env/dev.env and replace every CHANGE_ME value.
# dev.env is git-ignored; this example is not.

POSTGRES_USER=bandup
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bandup
RABBITMQ_DEFAULT_USER=bandup
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# Host ports for the dependency stack. The defaults below are the standard ports.
# Leave them out unless one of those ports is already in use on your machine; on Windows,
# `netsh interface ipv4 show excludedportrange protocol=tcp` lists reserved ranges, and a
# port inside one of them cannot be bound.
#
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# MAILPIT_HTTP_PORT=8025 (optional --profile recovery inbox; HTTP delivery, no SMTP port needed)
#
# Whatever you set here must match the connection strings and user secrets you configure
# for the API and the Worker, or they will talk to nothing.

# Not used by the dependency stack. Kept here as the reminder list of every secret the API
# needs in user secrets (development) or real environment variables (production):
#
#   Auth:SigningKey        32+ random characters, HMAC key for access tokens
#   PasswordReset:CodeProtectionKey  Base64 encoding 32+ random bytes, separate from the JWT key
#                                   Required at API startup; the Worker does not need this key
#   PasswordReset:RateLimitProvider  Redis by default; InMemory is for offline, single-process testing
#   OtpLogin:CodeProtectionKey       Base64 encoding 32+ random bytes, separate from JWT and reset keys
#                                   Required at API startup; the Worker does not need this key
#   OtpLogin:RateLimitProvider       Redis by default; InMemory is for offline, single-process testing
#   Email:Provider        InMemory by default; Mailpit for the local inbox; Resend for real delivery
#   Email:MailpitBaseUrl   http://localhost:8025/ (loopback only; no credentials in this URL)
#   Email:ResendApiKey     Required only with Email:Provider=Resend; store in API user secrets
#   Email:FromEmail        Verified Resend sender, or onboarding@resend.dev for account-only testing
#   Email:FromName         Sender display name, for example BandUp
#   Captcha:SecretKey      Cloudflare Turnstile secret key (only when Captcha:Provider=Turnstile)
#   Captcha:SiteKey        the matching public site key
