# Copy this file to infra/env/prod.env on the server and replace every CHANGE_ME value.
# prod.env is git-ignored; this example is not. Never commit the real file.

POSTGRES_USER=bandup
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=bandup

RABBITMQ_DEFAULT_USER=bandup
RABBITMQ_DEFAULT_PASS=CHANGE_ME

# 32+ random characters. Generate with: openssl rand -base64 48
AUTH_SIGNING_KEY=CHANGE_ME

# The deployed frontend origin, e.g. https://bandup.example.com
CORS_ALLOWED_ORIGIN=CHANGE_ME

# Fake until a real CAPTCHA provider is wired up (see S2-03).
CAPTCHA_PROVIDER=Fake
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=

# Optional. Leave blank to run without Sentry.
API_SENTRY_DSN=
WORKER_SENTRY_DSN=

# Image tags built and pushed by CI. Defaults to a local build if unset.
API_IMAGE=ghcr.io/OWNER/bandup-backend-api:latest
WORKER_IMAGE=ghcr.io/OWNER/bandup-backend-worker:latest
