{
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Cache": {
    "Provider": "Redis"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "User": "bandup",
    "VirtualHost": "/"
  },
  "MessagePublisher": {
    "Provider": "RabbitMq"
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:3000"
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "Swagger": {
    "Enabled": true
  },
  "Features": {
    "Diagnostics": true
  }
}