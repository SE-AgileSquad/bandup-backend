{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scoreLabel",
    "estimatedOverallBand",
    "summary",
    "criteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "scoreLabel": {
      "const": "estimated"
    },
    "estimatedOverallBand": {
      "$ref": "urn:bandup:writing:model:1#/$defs/score"
    },
    "summary": {
      "$ref": "urn:bandup:writing:model:1#/$defs/text"
    },
    "criteria": {
      "$ref": "urn:bandup:writing:model:1#/$defs/criteria"
    }
  }
}
